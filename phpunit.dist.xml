<?xml version="1.0" encoding="UTF-8"?>
<!--
  Ce fichier ne part PAS dans le paquet publié : voir `.gitattributes`.

  ⚠ `failOnWarning`, `failOnNotice` et `failOnDeprecation` sont volontaires.
  Une dépréciation PHP ou Symfony est le seul avertissement qu'on reçoive avant
  une rupture de version majeure — la laisser passer, c'est la découvrir le jour
  de la montée, sur dix applications à la fois.
-->
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
         cacheDirectory=".phpunit.cache"
         failOnWarning="true"
         failOnNotice="true"
         failOnDeprecation="true"
         displayDetailsOnTestsThatTriggerErrors="true"
         displayDetailsOnTestsThatTriggerDeprecations="true">
    <testsuites>
        <testsuite name="unitaire">
            <directory>tests</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>src</directory>
        </include>
    </source>
</phpunit>
